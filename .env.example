# Backend reads these generation settings from the environment or ignored .env.
# Never use a VITE_ prefix for credentials. Restart the API after changing them.
# VITE_APP_MODE defaults to local. The explicit build:portfolio profile selects portfolio.
ALETHIA_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
# Optional explicit local fallback mode; never selected automatically.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
# Vite forwards /api to this local backend during development.
ALETHIA_API_TARGET=http://127.0.0.1:8000
